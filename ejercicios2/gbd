CREATE TABLE paises (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL UNIQUE,
    codigo_iso CHAR(2) UNIQUE,
    continente ENUM('África', 'América', 'Asia', 'Europa', 'Oceanía', 'Antártida') NOT NULL,
    idioma_principal VARCHAR(50),
    idiomas_oficiales TEXT,
    poblacion BIGINT,
    pib DECIMAL(20,2) COMMENT 'en millones de USD',
    ingreso_per_capita DECIMAL(10,2) COMMENT 'en USD',
    moneda VARCHAR(50),
    capital VARCHAR(100),
    superficie DECIMAL(12,2) COMMENT 'en km²',
    fecha_actualizacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_continente (continente),
    INDEX idx_poblacion (poblacion),
    INDEX idx_ingreso (ingreso_per_capita)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

